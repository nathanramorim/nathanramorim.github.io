diff --git a/src/pages/projetos.astro b/src/pages/projetos.astro
new file mode 100644
index 0000000..12cc6b4
--- /dev/null
+++ b/src/pages/projetos.astro
@@ -0,0 +1,92 @@
+---
+import RetroLayout from '../layouts/RetroLayout.astro';
+import SiteFooter from '../presentation/components/SiteFooter.astro';
+import PortfolioGrid from '../presentation/components/PortfolioGrid.astro';
+import { GetPortfolioProjects } from '../domain/usecases/GetPortfolioProjects';
+import { PortfolioProjectRepository } from '../data/repositories/PortfolioProjectRepository';
+import { PagesConfigRepository } from '../data/repositories/PagesConfigRepository';
+
+if (!new PagesConfigRepository().isEnabled('projetos')) {
+	return Astro.redirect('/', 302);
+}
+
+const projects = await new GetPortfolioProjects(new PortfolioProjectRepository()).execute();
+
+const WHATSAPP_URL =
+	'https://wa.me/553198953514?text=Ol%C3%A1%20Nathan%2C%20vim%20pelo%20seu%20portf%C3%B3lio%20e%20quero%20conversar%20sobre%20um%20projeto.';
+---
+
+<RetroLayout
+	title="Projetos · Nathan Amorim"
+	description="Sistemas, SaaS e sites que já desenvolvi: qual era o problema de cada um, o que eu fiz e o resultado na prática."
+	chromeTitle="projetos"
+>
+	<header class="index-hero">
+		<p class="eyebrow">Projetos</p>
+		<h1>Cada projeto aqui começou com uma pergunta simples<span class="cursor">&nbsp;</span></h1>
+		<p>
+			É simples assim: qual é o problema, e como a gente resolve isso? Foi essa pergunta que guiou
+			cada um dos projetos abaixo, de sistemas que uso todo santo dia até ferramentas que criei só
+			pra mim mesmo. Sem enrolação técnica: pra cada um, conto qual era a dor, o que eu fiz e o que
+			mudou na prática.
+		</p>
+	</header>
+
+	<section class="portfolio-section">
+		<PortfolioGrid projects={projects} />
+	</section>
+
+	<section class="footer-cta">
+		<p class="eyebrow" style="text-align: center;">Tem um problema parecido?</p>
+		<h2 class="section-title">Me conta o que está travando no seu negócio</h2>
+		<p class="section-lead">
+			Se algum desses projetos se parece com um problema que você tem, ou nem se parece e ainda
+			assim quer trocar uma ideia, é só chamar.
+		</p>
+		<div class="footer-actions">
+			<a class="btn-primary" href={WHATSAPP_URL} target="_blank" rel="noopener">💬 Falar no WhatsApp</a>
+			<a class="btn-outline" href="/">← Voltar pro início</a>
+		</div>
+	</section>
+
+	<SiteFooter />
+</RetroLayout>
+
+<style>
+	.portfolio-section {
+		padding: 8px 0 72px;
+	}
+
+	.footer-cta {
+		padding: 8px 0 72px;
+	}
+
+	.footer-actions {
+		display: flex;
+		flex-wrap: wrap;
+		justify-content: center;
+		gap: 12px;
+		margin-top: 20px;
+	}
+
+	.section-title {
+		max-width: 760px;
+		margin: 0 auto 12px;
+		padding: 0 24px;
+		font-family: var(--body);
+		font-weight: 800;
+		font-size: 1.5rem;
+		color: var(--text);
+		text-align: center;
+	}
+
+	.section-lead {
+		max-width: 640px;
+		margin: 0 auto 8px;
+		padding: 0 24px;
+		font-family: var(--body);
+		color: var(--text-dim);
+		font-size: 0.95rem;
+		text-align: center;
+	}
+</style>
diff --git a/src/presentation/components/PortfolioGrid.astro b/src/presentation/components/PortfolioGrid.astro
new file mode 100644
index 0000000..d719726
--- /dev/null
+++ b/src/presentation/components/PortfolioGrid.astro
@@ -0,0 +1,183 @@
+---
+import type { PortfolioProject } from '../../domain/entities/PortfolioProject';
+
+interface Props {
+	projects: PortfolioProject[];
+}
+
+const { projects } = Astro.props;
+---
+
+<div class="portfolio-grid">
+	{
+		projects.map((project) => (
+			<article class:list={['portfolio-card', { 'portfolio-card-destaque': project.destaque }]}>
+				<div class="portfolio-image-wrap">
+					<img src={project.image} alt={project.imageAlt} loading="lazy" width="1200" height="750" />
+				</div>
+				<div class="portfolio-body">
+					<p class="portfolio-status">{project.status}</p>
+					<h3 class="portfolio-name">{project.name}</h3>
+					<p class="portfolio-tagline">{project.tagline}</p>
+
+					<div class="portfolio-field">
+						<p class="portfolio-field-label">🤔 O problema</p>
+						<p class="portfolio-field-text">{project.problema}</p>
+					</div>
+					<div class="portfolio-field">
+						<p class="portfolio-field-label">🛠️ O que eu fiz</p>
+						<p class="portfolio-field-text">{project.solucao}</p>
+					</div>
+					<div class="portfolio-field">
+						<p class="portfolio-field-label">✅ Resultado</p>
+						<p class="portfolio-field-text">{project.resultado}</p>
+					</div>
+
+					<div class="portfolio-tags">
+						{project.stack.map((tech) => (
+							<span class="hashtag">{tech}</span>
+						))}
+					</div>
+
+					{project.link && (
+						<a class="portfolio-link" href={project.link} target="_blank" rel="noopener noreferrer">
+							{project.linkLabel ?? 'ver projeto'} &rarr;
+						</a>
+					)}
+				</div>
+			</article>
+		))
+	}
+</div>
+
+<style>
+	.portfolio-grid {
+		display: grid;
+		grid-template-columns: repeat(2, 1fr);
+		gap: 20px;
+		max-width: 1080px;
+		margin: 0 auto;
+		padding: 0 24px;
+	}
+
+	.portfolio-card {
+		background: var(--panel);
+		border: 1px solid var(--panel-border);
+		border-radius: var(--radius);
+		overflow: hidden;
+		display: flex;
+		flex-direction: column;
+	}
+
+	.portfolio-card-destaque {
+		grid-column: 1 / -1;
+		display: grid;
+		grid-template-columns: 1fr 1fr;
+	}
+
+	.portfolio-image-wrap {
+		background: #fff;
+		border-bottom: 1px solid var(--panel-border);
+		aspect-ratio: 16 / 10;
+		overflow: hidden;
+	}
+
+	.portfolio-card-destaque {
+		align-items: center;
+	}
+
+	.portfolio-card-destaque .portfolio-image-wrap {
+		border-bottom: none;
+		border-right: 1px solid var(--panel-border);
+	}
+
+	.portfolio-image-wrap img {
+		width: 100%;
+		height: 100%;
+		object-fit: cover;
+		display: block;
+	}
+
+	.portfolio-body {
+		padding: 22px;
+		display: flex;
+		flex-direction: column;
+		flex: 1;
+	}
+
+	.portfolio-status {
+		font-family: var(--mono);
+		font-size: 11px;
+		font-weight: 700;
+		text-transform: uppercase;
+		letter-spacing: 0.4px;
+		color: var(--cyan);
+		margin: 0 0 8px;
+	}
+
+	.portfolio-name {
+		font-family: var(--body);
+		font-weight: 800;
+		font-size: 1.15rem;
+		color: var(--text);
+		margin: 0 0 6px;
+	}
+
+	.portfolio-tagline {
+		font-family: var(--body);
+		font-size: 0.9rem;
+		color: var(--text-dim);
+		font-style: italic;
+		margin: 0 0 16px;
+	}
+
+	.portfolio-field {
+		margin-bottom: 14px;
+	}
+
+	.portfolio-field-label {
+		font-family: var(--body);
+		font-weight: 700;
+		font-size: 0.8rem;
+		color: var(--text);
+		margin: 0 0 4px;
+	}
+
+	.portfolio-field-text {
+		font-family: var(--body);
+		font-size: 0.86rem;
+		color: var(--text-dim);
+		line-height: 1.6;
+		margin: 0;
+	}
+
+	.portfolio-tags {
+		display: flex;
+		flex-wrap: wrap;
+		gap: 6px;
+		margin: 4px 0 14px;
+	}
+
+	.portfolio-link {
+		font-family: var(--body);
+		font-weight: 700;
+		font-size: 0.86rem;
+		margin-top: auto;
+	}
+
+	@media (max-width: 900px) {
+		.portfolio-grid {
+			grid-template-columns: 1fr;
+		}
+
+		.portfolio-card-destaque {
+			grid-template-columns: 1fr;
+		}
+
+		.portfolio-card-destaque .portfolio-image-wrap {
+			border-right: none;
+			border-bottom: 1px solid var(--panel-border);
+			aspect-ratio: 16 / 10;
+		}
+	}
+</style>
