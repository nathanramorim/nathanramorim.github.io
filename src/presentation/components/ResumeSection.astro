---
import type { Experience } from '../../domain/entities/Experience';
import type { Education } from '../../domain/entities/Education';
import type { Certification } from '../../domain/entities/Certification';
import type { Language } from '../../domain/entities/Language';
import type { Project } from '../../domain/entities/Project';
import ProjectGrid from './ProjectGrid.astro';
import ExperienceTimeline from './ExperienceTimeline.astro';
import EducationList from './EducationList.astro';
import SkillsSection from './SkillsSection.astro';
import CertificationsList from './CertificationsList.astro';
import LanguagesList from './LanguagesList.astro';

interface Props {
	experiences: Experience[];
	education: Education[];
	certifications: Certification[];
	languages: Language[];
	projects: Project[];
	downloadMode?: 'print' | 'link';
}

const { experiences, education, certifications, languages, projects, downloadMode = 'print' } = Astro.props;

const metrics = [
	{ value: '10+', label: 'Anos de experiência' },
	{ value: '3+', label: 'Anos como Tech Lead' },
	{ value: '1', label: 'Empresa fundada' },
	{ value: 'IA', label: 'Aplicada a produtos reais' },
];
---

<div class="cv-download-bar screen-only">
	{
		downloadMode === 'print' ? (
			<button id="cv-download-pdf" type="button" class="cv-download-btn">
				⬇ Baixar currículo em PDF
			</button>
		) : (
			<a href="/cv" class="cv-download-btn cv-download-link">
				⬇ Baixar currículo em PDF
			</a>
		)
	}
</div>

<div class="cv-layout">
	<div class="cv-main">
		<div class="print-hide-section">
			<p class="eyebrow">Case · Projeto</p>
			<ProjectGrid projects={projects} />
		</div>

		<div>
			<p class="eyebrow">Experiência Profissional</p>
			<h2 class="print-only print-heading">Experiência Profissional</h2>
			<ExperienceTimeline experiences={experiences} />
		</div>

		<div>
			<p class="eyebrow">Competências Técnicas</p>
			<h2 class="print-only print-heading">Competências Técnicas</h2>
			<SkillsSection />
		</div>
	</div>

	<aside class="cv-sidebar">
		<div class="cv-card">
			<p class="cv-card-title">Números</p>
			<div class="metrics-grid">
				{
					metrics.map((metric) => (
						<div class="metric">
							<div class="metric-value">{metric.value}</div>
							<div class="metric-label">{metric.label}</div>
						</div>
					))
				}
			</div>
		</div>

		<div class="cv-card">
			<p class="cv-card-title">Contato</p>
			<div class="contact-list">
				<a href="mailto:nathan.ramorim@gmail.com">✉️ nathan.ramorim@gmail.com</a>
				<a href="https://www.linkedin.com/in/nathanramorim/" target="_blank" rel="noopener">💼 linkedin.com/in/nathanramorim</a>
				<a href="https://github.com/nathanramorim" target="_blank" rel="noopener">🐙 github.com/nathanramorim</a>
				<span class="contact-location">📍 Barbacena, MG · Brasil</span>
			</div>
		</div>

		<div class="cv-card">
			<p class="cv-card-title">Formação Acadêmica</p>
			<h2 class="print-only print-heading">Formação Acadêmica</h2>
			<EducationList education={education} />
		</div>

		<div class="cv-card">
			<p class="cv-card-title">Idiomas</p>
			<LanguagesList languages={languages} />
		</div>

		<div class="cv-card">
			<p class="cv-card-title">Licenças &amp; Certificados</p>
			<CertificationsList certifications={certifications} />
		</div>
	</aside>
</div>

{
	downloadMode === 'print' && (
		<script>
			document.getElementById('cv-download-pdf')?.addEventListener('click', () => {
				window.print();
			});
		</script>
	)
}

<style>
	.cv-download-bar {
		max-width: 760px;
		margin: 0 auto 32px;
		padding: 0 24px;
		display: flex;
		justify-content: center;
	}

	.cv-download-btn {
		font-family: var(--mono);
		font-size: 13px;
		color: var(--bg);
		background: var(--green);
		border: none;
		border-radius: var(--radius);
		padding: 10px 18px;
		cursor: pointer;
		transition: filter 0.15s ease;
	}

	.cv-download-link {
		display: inline-block;
	}

	.cv-download-link:hover {
		text-decoration: none;
	}

	.cv-download-btn:hover {
		filter: brightness(1.1);
	}

	.cv-download-btn:focus-visible {
		outline: 2px solid var(--cyan);
		outline-offset: 2px;
	}

	.cv-layout {
		display: grid;
		grid-template-columns: 1fr 320px;
		gap: 24px;
		align-items: start;
		max-width: 1080px;
		margin: 0 auto 40px;
		padding: 0 24px;
	}

	.cv-main {
		display: flex;
		flex-direction: column;
		gap: 32px;
		min-width: 0;
	}

	.cv-main :global(.project-grid),
	.cv-main :global(.experience-timeline),
	.cv-main :global(.skills-section) {
		max-width: none;
		margin: 0;
		padding: 0;
	}

	.cv-main :global(.eyebrow) {
		text-align: left;
	}

	.cv-sidebar {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.cv-card {
		background: var(--panel);
		border: 1px solid var(--panel-border);
		border-radius: var(--radius);
		padding: 20px;
	}

	.cv-card-title {
		font-family: var(--body);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 1.4px;
		text-transform: uppercase;
		color: var(--cyan);
		margin: 0 0 14px;
		padding-bottom: 10px;
		border-bottom: 1px solid var(--panel-border);
	}

	.cv-card :global(.education-list),
	.cv-card :global(.edu-item) {
		max-width: none;
		margin: 0;
		padding: 0;
		background: transparent;
		border: none;
	}

	.metrics-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 10px;
	}

	.metric {
		background: var(--bg);
		border: 1px solid var(--panel-border);
		border-radius: 10px;
		padding: 12px 8px;
		text-align: center;
	}

	.metric-value {
		font-family: var(--body);
		font-weight: 800;
		font-size: 1.3rem;
		color: var(--cyan);
	}

	.metric-label {
		font-family: var(--body);
		font-size: 0.68rem;
		color: var(--text-dim);
		margin-top: 2px;
	}

	.contact-list {
		display: flex;
		flex-direction: column;
		gap: 10px;
		font-family: var(--body);
		font-size: 0.84rem;
	}

	.contact-list a {
		color: var(--text-dim);
	}

	.contact-list a:hover {
		color: var(--cyan);
	}

	.contact-location {
		color: var(--text-dim);
	}

	@media print {
		.print-hide-section {
			display: none;
		}

		.cv-layout {
			display: block;
			max-width: 100%;
			padding: 0;
		}

		.cv-sidebar {
			margin-top: 20px;
		}

		.cv-card {
			background: #fff;
			border: none;
			border-bottom: 1px solid #ddd;
			border-radius: 0;
			padding: 0 0 14px;
			margin-bottom: 14px;
			break-inside: avoid;
		}

		.cv-card-title {
			color: #111;
		}

		.metric-value {
			color: #111;
		}

		.metric {
			background: #fff;
			border: 1px solid #ddd;
		}

		.contact-list a,
		.contact-location {
			color: #333 !important;
		}
	}

	@media (max-width: 820px) {
		.cv-layout {
			grid-template-columns: 1fr;
		}
	}
</style>
