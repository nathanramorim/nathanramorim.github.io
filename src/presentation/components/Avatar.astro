---
import { Image } from 'astro:assets';
import avatar from '../../assets/avatar.jpg';

interface Props {
	size?: number;
}

const { size = 120 } = Astro.props;
---

<div class="avatar-frame" style={`--avatar-size: ${size}px`}>
	<Image src={avatar} alt="Foto de Nathan Amorim" width={size} height={size} />
</div>

<style>
	.avatar-frame {
		width: var(--avatar-size);
		height: var(--avatar-size);
		flex-shrink: 0;
		border-radius: 50%;
		padding: 3px;
		background: linear-gradient(135deg, var(--cyan), var(--green));
		box-shadow: 0 0 24px rgba(127, 252, 255, 0.25);
	}

	.avatar-frame :global(img) {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		object-fit: cover;
		display: block;
		background: var(--panel);
	}
</style>
