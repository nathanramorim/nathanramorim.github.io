---
import type { Experience } from '../../domain/entities/Experience';

interface Props {
	experiences: Experience[];
}

const { experiences } = Astro.props;
---

<section class="experience-timeline">
	{
		experiences.map((experience) => (
			<div class="company-group">
				<div class="company-header">
					<span class="company-name">{experience.company}</span>
					<span class="company-type">{experience.type}</span>
					<span class="company-tenure">{experience.tenure}</span>
				</div>
				{experience.roles.map((role) => (
					<div class="role-item">
						<div class="role-header">
							<span class="role-title">
								{role.title}
								{role.badge && <span class="role-badge">{role.badge}</span>}
							</span>
							<span class="role-period">
								{role.period}
								{role.duration ? ` · ${role.duration}` : ''}
							</span>
						</div>
						{role.company_detail && <p class="role-company-detail">{role.company_detail}</p>}
						{role.description && <p class="role-description">{role.description}</p>}
						<div class="role-tags">
							{role.tags.map((tag) => (
								<span class="hashtag">#{tag.replace(/\s+/g, '')}</span>
							))}
						</div>
					</div>
				))}
			</div>
		))
	}
</section>

<style>
	.experience-timeline {
		max-width: 760px;
		margin: 0 auto 40px;
		padding: 0 24px;
	}

	.company-group {
		border: 1px solid var(--panel-border);
		border-radius: var(--radius);
		background: var(--panel);
		padding: 20px 22px;
		margin-bottom: 20px;
	}

	.company-header {
		display: flex;
		align-items: baseline;
		gap: 10px;
		flex-wrap: wrap;
		margin-bottom: 16px;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--panel-border);
	}

	.company-name {
		font-family: var(--pixel);
		font-size: 13px;
		color: var(--cyan);
	}

	.company-type,
	.company-tenure {
		font-family: var(--mono);
		font-size: 11px;
		color: var(--text-dim);
	}

	.role-item {
		margin-bottom: 18px;
	}

	.role-item:last-child {
		margin-bottom: 0;
	}

	.role-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 6px;
		margin-bottom: 6px;
	}

	.role-title {
		font-family: var(--body);
		font-weight: 600;
		font-size: 15px;
		color: var(--text);
	}

	.role-badge {
		font-family: var(--mono);
		font-size: 9px;
		color: var(--green);
		border: 1px solid var(--panel-border-strong);
		border-radius: var(--radius);
		padding: 2px 6px;
		margin-left: 8px;
	}

	.role-period {
		font-family: var(--mono);
		font-size: 12px;
		color: var(--text-dim);
	}

	.role-company-detail {
		font-family: var(--mono);
		font-size: 12px;
		color: var(--green);
		margin: 0 0 6px;
	}

	.role-description {
		font-family: var(--body);
		font-size: 14px;
		color: var(--text-dim);
		line-height: 1.65;
		margin: 0 0 10px;
	}

	.role-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
</style>
