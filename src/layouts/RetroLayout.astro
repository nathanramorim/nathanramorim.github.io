---
import '../styles/global.css';
import SEO from '../presentation/components/SEO.astro';

interface Props {
	title: string;
	description: string;
	chromeTitle: string;
	image?: string;
}

const { title, description, chromeTitle, image } = Astro.props;

const FONTS_URL =
	'https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap';

const WHATSAPP_URL =
	'https://wa.me/553198953514?text=Ol%C3%A1%20Nathan%2C%20vim%20pelo%20seu%20site%20e%20quero%20conversar%20sobre%20um%20projeto.';
---

<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="light only" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href={FONTS_URL} media="print" onload="this.media='all'" />
		<noscript>
			<link rel="stylesheet" href={FONTS_URL} />
		</noscript>

		<SEO title={title} description={description} image={image} />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Pular para o conteúdo</a>

		<div class="crt-overlay"></div>

		<div class="chrome">
			<a href="/" class="chrome-title">Nathan Amorim</a>
			<div class="chrome-nav">
				<a href="/">Início</a>
				<a href="/projetos">Projetos</a>
				<a href="/blog">Blog</a>
				<a href={WHATSAPP_URL} target="_blank" rel="noopener" class="chrome-cta">Vamos conversar</a>
			</div>
		</div>

		<div id="main-content">
			<slot />
		</div>

		<a class="wa-float" href={WHATSAPP_URL} target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
			<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path
					d="M16.004 2.667c-7.363 0-13.337 5.974-13.337 13.337 0 2.353.615 4.65 1.783 6.671L2.667 29.333l6.83-1.752a13.29 13.29 0 0 0 6.507 1.66h.006c7.363 0 13.337-5.974 13.337-13.337S23.367 2.667 16.004 2.667Zm0 24.4h-.005a11.06 11.06 0 0 1-5.636-1.543l-.404-.24-4.053 1.04 1.082-3.951-.264-.406a11.04 11.04 0 0 1-1.694-5.926c0-6.108 4.97-11.077 11.079-11.077 2.96 0 5.742 1.153 7.834 3.246a11 11 0 0 1 3.243 7.837c0 6.108-4.97 11.02-11.182 11.02Zm6.077-8.276c-.333-.167-1.966-.97-2.271-1.081-.305-.111-.527-.167-.75.167-.222.333-.86 1.08-1.055 1.303-.194.222-.388.25-.72.083-.334-.166-1.409-.52-2.684-1.657-.992-.885-1.663-1.978-1.858-2.311-.194-.333-.02-.513.147-.679.15-.15.334-.389.5-.583.167-.194.223-.333.334-.556.111-.222.055-.417-.028-.583-.083-.167-.75-1.806-1.028-2.474-.271-.653-.546-.565-.75-.575l-.639-.011c-.222 0-.583.083-.888.417-.305.333-1.166 1.14-1.166 2.778s1.194 3.222 1.361 3.444c.166.222 2.35 3.588 5.694 5.032.796.343 1.417.548 1.901.702.798.254 1.524.218 2.098.132.64-.095 1.966-.803 2.243-1.58.277-.777.277-1.443.194-1.581-.083-.139-.305-.222-.639-.389Z"
					fill="#fff"
				></path>
			</svg>
		</a>
	</body>
</html>
