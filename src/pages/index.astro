---
import RetroLayout from '../layouts/RetroLayout.astro';
import Terminal from '../presentation/components/Terminal.astro';
import ProjectGrid from '../presentation/components/ProjectGrid.astro';
import SkillsSection from '../presentation/components/SkillsSection.astro';
import FeaturedPosts from '../presentation/components/FeaturedPosts.astro';
import SiteFooter from '../presentation/components/SiteFooter.astro';
import { GetProjectsList } from '../domain/usecases/GetProjectsList';
import { ProjectRepository } from '../data/repositories/ProjectRepository';
import { GetFeaturedPosts } from '../domain/usecases/GetFeaturedPosts';

const projects = await new GetProjectsList(new ProjectRepository()).execute();
const featuredPosts = await GetFeaturedPosts(3);
---

<RetroLayout title="Nathan Amorim – Tech Lead & Solution Architect" chromeTitle="nathan-amorim">
	<header class="index-hero">
		<p class="eyebrow">whoami</p>
		<h1>Nathan Amorim<span class="cursor">&nbsp;</span></h1>
		<p>Solutions Architect · Tech Lead · Software Engineer, movido por desafios complexos e por transformar sistemas críticos em soluções escaláveis e resilientes.</p>
	</header>

	<Terminal />

	<section>
		<p class="eyebrow" style="text-align: center;">cat projetos/</p>
		<ProjectGrid projects={projects} />
	</section>

	<section>
		<p class="eyebrow" style="text-align: center;">ls skills/</p>
		<SkillsSection />
	</section>

	<section>
		<p class="eyebrow" style="text-align: center;">tail -f blog/destaques.log</p>
		<FeaturedPosts posts={featuredPosts} />
	</section>

	<SiteFooter />
</RetroLayout>
