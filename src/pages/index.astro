---
import RetroLayout from '../layouts/RetroLayout.astro';
import Avatar from '../presentation/components/Avatar.astro';
import FeaturedPosts from '../presentation/components/FeaturedPosts.astro';
import SiteFooter from '../presentation/components/SiteFooter.astro';
import { GetFeaturedPosts } from '../domain/usecases/GetFeaturedPosts';
import decisoes from '../data/sources/decisoes.json';
import ferramentas from '../data/sources/ferramentas.json';
import podcasts from '../data/sources/podcasts.json';
import experiences from '../data/sources/experiences.json';

const featuredPosts = await GetFeaturedPosts(2);

const WHATSAPP_URL =
	'https://wa.me/553198953514?text=Ol%C3%A1%20Nathan%2C%20vim%20pelo%20seu%20site%20e%20quero%20conversar%20sobre%20um%20projeto.';
const GITHUB_URL = 'https://github.com/nathanramorim';

const pilares = [
	{ icon: '🧭', title: 'Arquitetura', text: 'soluções que cabem no orçamento e na governança' },
	{ icon: '🤖', title: 'Operação com IA', text: 'agentes que vão da tarefa ao deploy' },
	{ icon: '⚙️', title: 'Automação', text: 'trabalho manual que passa a rodar sozinho' },
	{ icon: '👥', title: 'Liderança técnica', text: 'times que entregam com método, não com heroísmo' },
];

const experiencia = experiences.map((e) => ({
	empresa: e.company,
	tempo: e.tenure,
	cargo: e.roles[0].title,
	periodo: e.roles[0].period,
	antes: e.roles.slice(1).map((r) => r.title).filter((t, i, a) => a.indexOf(t) === i && t !== e.roles[0].title),
}));
---

<RetroLayout
	title="Nathan Amorim · Arquiteto de Soluções e Tech Lead"
	description="Arquiteto de Soluções e Tech Lead, com mais de 10 anos em desenvolvimento de software. Transformo problema de negócio em sistema funcionando, usando IA no jeito de entregar."
	chromeTitle="nathan-amorim"
>
	<header class="hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">Arquiteto de Soluções · Tech Lead · Operação com IA</p>
			<h1>Transformo problema de negócio em <span class="accent">sistema funcionando.</span><span class="cursor">&nbsp;</span></h1>
			<p>
				Sou o Nathan Amorim, arquiteto de soluções e tech lead na DTI Digital e fundador da Busize.
				Meu foco não é a linguagem: é entregar resultado sem surpresa. Primeiro escrevo o que vai
				ser feito, os agentes de IA fazem o trabalho repetitivo e as pessoas decidem o que importa.
			</p>
			<div class="hero-actions">
				<a class="btn-primary" href={WHATSAPP_URL} target="_blank" rel="noopener">💬 Conversar sobre um projeto</a>
				<a class="btn-outline" href={GITHUB_URL} target="_blank" rel="noopener">🐙 Ver no GitHub</a>
			</div>
		</div>

		<div class="hero-card">
			<Avatar size={120} />
			<div class="hero-card-name">Nathan Amorim</div>
			<div class="hero-card-role">Arquiteto de Soluções e Tech Lead</div>
			<div class="hero-card-stats">
				<div class="stat"><div class="stat-value">10+</div><div class="stat-label">Anos em desenvolvimento</div></div>
				<div class="stat"><div class="stat-value">5+</div><div class="stat-label">Anos liderando times</div></div>
				<div class="stat"><div class="stat-value">4</div><div class="stat-label">Ferramentas abertas</div></div>
				<div class="stat"><div class="stat-value">2</div><div class="stat-label">Podcasts</div></div>
			</div>
		</div>
	</header>

	<section class="pilares-section">
		<div class="pilares-grid">
			{
				pilares.map((p) => (
					<div class="pilar">
						<div class="pilar-icon">{p.icon}</div>
						<p class="pilar-title">{p.title}</p>
						<p class="pilar-text">{p.text}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="img-section" id="como-entrego">
		<p class="eyebrow" style="text-align: center;">Como eu entrego</p>
		<p class="section-lead">Cada tarefa é um card no GitHub Project. O agente só começa quando o card chega na coluna dele.</p>
		<div class="img-wrap">
			<img src="/images/home/fluxo-entrega.svg" alt="Fluxo de entrega: problema, o que fazer, pessoa aprova, agentes de IA, no ar" width="1280" height="406" />
		</div>
	</section>

	<section class="decisoes-section" id="decisoes">
		<p class="eyebrow" style="text-align: center;">Decisões de arquitetura</p>
		<h2 class="section-title">Duas decisões reais, contadas de forma simples</h2>
		<p class="section-lead">Os clientes estão anonimizados. O que importa aqui é o porquê de cada escolha.</p>
		<div class="decisoes-list">
			{
				decisoes.map((d) => (
					<article class="decisao">
						<h3>{d.titulo}</h3>
						<img src={d.imagem} alt={d.imagemAlt} loading="lazy" width="1280" height="546" />
						<div class="decisao-grid">
							<div><p class="decisao-label">🧩 O desafio</p><p>{d.desafio}</p></div>
							<div><p class="decisao-label">✅ A decisão</p><p>{d.decisao}</p></div>
							<div><p class="decisao-label">💡 Por quê</p><p>{d.porque}</p></div>
						</div>
					</article>
				))
			}
		</div>
	</section>

	<section class="img-section">
		<p class="eyebrow" style="text-align: center;">Como eu decido</p>
		<div class="img-wrap">
			<img src="/images/home/principios.svg" alt="Seis princípios: governança primeiro, escrever antes de codar, custo é requisito, só o necessário, fazer uma vez e usar sempre, pessoa decide" loading="lazy" width="1280" height="476" />
		</div>
	</section>

	<section class="img-section">
		<p class="eyebrow" style="text-align: center;">Resultados</p>
		<div class="img-wrap">
			<img src="/images/home/cases.svg" alt="Três cases: escritório contábil, rede de autopeças e SaaS indo para produção" loading="lazy" width="1280" height="466" />
		</div>
	</section>

	<section class="exp-section" id="experiencia">
		<p class="eyebrow" style="text-align: center;">Experiência</p>
		<h2 class="section-title">Onde construí essa forma de trabalhar</h2>
		<div class="exp-grid">
			{
				experiencia.map((e) => (
					<div class="exp-card">
						<p class="exp-empresa">{e.empresa}</p>
						<p class="exp-cargo">{e.cargo}</p>
						<p class="exp-periodo">{e.periodo} · {e.tempo} na empresa</p>
						{e.antes.length > 0 && <p class="exp-antes">Antes: {e.antes.join(', ')}</p>}
					</div>
				))
			}
		</div>
		<div class="hero-actions" style="justify-content: center; margin-top: 24px;">
			<a class="btn-outline" href="/cv">📄 Ver o currículo completo</a>
		</div>
	</section>

	<section class="ferramentas-section" id="ferramentas">
		<p class="eyebrow" style="text-align: center;">Ferramentas abertas</p>
		<h2 class="section-title">O que criei pra trabalhar com IA no dia a dia</h2>
		<p class="section-lead">
			Além do <a href="https://forge-sdd.vercel.app" target="_blank" rel="noopener">Forge SDD</a>, três plugins abertos pra Claude Code e agy.
		</p>
		<div class="ferramentas-grid">
			{
				ferramentas.map((f) => (
					<a class="ferramenta" href={f.url} target="_blank" rel="noopener">
						<img src={f.imagem} alt={`Banner do ${f.nome}`} loading="lazy" width="1280" height="420" />
						<div class="ferramenta-body">
							<p class="ferramenta-nome">{f.nome}</p>
							<p>{f.frase}</p>
						</div>
					</a>
				))
			}
		</div>
	</section>

	<section class="podcasts-section" id="podcasts">
		<p class="eyebrow" style="text-align: center;">Podcasts</p>
		<h2 class="section-title">Onde já conversei sobre isso</h2>
		<div class="podcasts-grid">
			{
				podcasts.map((p) => (
					<iframe
						title={`${p.titulo} · ${p.programa}`}
						src={p.url.replace('open.spotify.com/episode/', 'open.spotify.com/embed/episode/')}
						width="100%"
						height="152"
						frameborder="0"
						allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
						loading="lazy"
					></iframe>
				))
			}
		</div>
	</section>

	<section class="blog-section">
		<p class="eyebrow" style="text-align: center;">Blog</p>
		<FeaturedPosts posts={featuredPosts} />
	</section>

	<section class="footer-cta">
		<p class="eyebrow" style="text-align: center;">Vamos conversar?</p>
		<h2 class="section-title">Tem um problema que precisa virar sistema?</h2>
		<p class="section-lead">
			Se você tem um projeto em mente, um sistema que precisa evoluir ou um processo que está
			consumindo tempo da sua equipe, me chama.
		</p>
		<div class="footer-actions">
			<a class="btn-primary" href={WHATSAPP_URL} target="_blank" rel="noopener">💬 Falar no WhatsApp</a>
			<a class="btn-outline" href="https://www.linkedin.com/in/nathanramorim/" target="_blank" rel="noopener">💼 LinkedIn</a>
		</div>
	</section>

	<SiteFooter />
</RetroLayout>

<style>
	.accent {
		color: var(--cyan);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: 48px;
		align-items: center;
		max-width: 1080px;
		margin: 0 auto;
		padding: 56px 24px 20px;
	}

	.hero-copy h1 {
		font-family: var(--pixel);
		font-weight: 900;
		font-size: clamp(2rem, 3.6vw, 2.8rem);
		line-height: 1.15;
		color: var(--text);
		margin: 14px 0 16px;
	}

	.hero-copy p {
		font-family: var(--body);
		color: var(--text-dim);
		font-size: 1rem;
		line-height: 1.7;
	}

	.hero-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 20px;
	}

	.meta-chip {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--body);
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--text-dim);
		background: var(--panel);
		border: 1px solid var(--panel-border);
		padding: 6px 12px;
		border-radius: 999px;
	}

	.hero-card {
		background: #fff;
		border: 1px solid var(--panel-border);
		border-radius: 20px;
		box-shadow: var(--shadow, 0 1px 2px rgba(15, 23, 42, .04), 0 8px 24px -12px rgba(15, 23, 42, .10));
		padding: 28px;
		text-align: center;
	}

	.hero-card :global(.avatar-frame) {
		margin: 0 auto;
	}

	.hero-card-name {
		font-family: var(--body);
		font-size: 1.15rem;
		font-weight: 800;
		color: var(--text);
		margin-top: 12px;
	}

	.hero-card-role {
		font-family: var(--body);
		font-size: 0.84rem;
		color: var(--cyan);
		font-weight: 700;
		margin-top: 4px;
		margin-bottom: 16px;
	}

	.chip-list {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
		justify-content: center;
	}

	.hero-card-chips {
		margin-bottom: 20px;
	}

	.chip {
		background: var(--panel);
		border: 1px solid var(--panel-border);
		color: var(--text);
		font-family: var(--body);
		font-size: 0.78rem;
		font-weight: 600;
		padding: 5px 12px;
		border-radius: 8px;
	}

	.hero-card-stats {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 10px;
	}

	.stat {
		background: var(--panel);
		border: 1px solid var(--panel-border);
		border-radius: 12px;
		padding: 12px 8px;
	}

	.stat-value {
		font-family: var(--body);
		font-size: 1.35rem;
		font-weight: 900;
		color: var(--cyan);
		line-height: 1;
	}

	.stat-label {
		font-family: var(--body);
		font-size: 0.68rem;
		color: var(--text-dim);
		margin-top: 4px;
		font-weight: 500;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 20px;
	}

	.btn-primary,
	.btn-outline {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--body);
		font-size: 0.88rem;
		font-weight: 700;
		padding: 12px 22px;
		border-radius: 10px;
		border: 1px solid transparent;
	}

	.btn-primary {
		background: var(--cyan);
		color: #fff !important;
	}

	.btn-primary:hover {
		background: var(--green);
		text-decoration: none;
	}

	.btn-outline {
		background: #fff;
		color: var(--text) !important;
		border-color: var(--panel-border);
	}

	.btn-outline:hover {
		border-color: var(--cyan);
		color: var(--cyan) !important;
		text-decoration: none;
	}


	.section-title {
		max-width: 760px;
		margin: 0 auto 12px;
		padding: 0 24px;
		font-family: var(--body);
		font-weight: 800;
		font-size: 1.5rem;
		color: var(--text);
		text-align: center;
	}

	.section-lead {
		max-width: 640px;
		margin: 0 auto 32px;
		padding: 0 24px;
		font-family: var(--body);
		color: var(--text-dim);
		font-size: 0.95rem;
		text-align: center;
	}


	.footer-cta {
		text-align: center;
		padding: 72px 0;
	}

	.footer-actions {
		display: flex;
		justify-content: center;
		gap: 12px;
		flex-wrap: wrap;
	}

	.blog-section {
		padding: 72px 0;
	}

	.blog-section :global(.index-list) {
		margin: 0 auto;
	}


	.pilares-section,
	.img-section,
	.decisoes-section,
	.exp-section,
	.ferramentas-section,
	.podcasts-section {
		padding: 72px 0;
	}

	.pilares-section {
		padding-top: 24px;
	}

	.pilares-grid,
	.exp-grid,
	.ferramentas-grid {
		max-width: 1080px;
		margin: 0 auto;
		padding: 0 24px;
		display: grid;
		gap: 16px;
	}

	.pilares-grid {
		grid-template-columns: repeat(4, 1fr);
	}

	.pilar,
	.exp-card {
		background: var(--panel);
		border: 1px solid var(--panel-border);
		border-radius: var(--radius);
		padding: 20px;
		font-family: var(--body);
	}

	.pilar {
		text-align: center;
	}

	.pilar-icon {
		font-size: 1.6rem;
	}

	.pilar-title {
		font-weight: 800;
		color: var(--text);
		margin: 8px 0 4px;
	}

	.pilar-text {
		color: var(--text-dim);
		font-size: 0.88rem;
		margin: 0;
	}

	.img-wrap {
		max-width: 1080px;
		margin: 0 auto;
		padding: 0 24px;
	}

	.img-wrap img,
	.decisao img {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 14px;
		border: 1px solid var(--panel-border);
	}

	.decisoes-list {
		max-width: 1080px;
		margin: 0 auto;
		padding: 0 24px;
		display: flex;
		flex-direction: column;
		gap: 48px;
	}

	.decisao h3 {
		font-family: var(--body);
		font-weight: 800;
		color: var(--text);
		margin: 0 0 12px;
	}

	.decisao-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
		margin-top: 16px;
	}

	.decisao-grid p {
		margin: 0;
		font-family: var(--body);
		font-size: 0.92rem;
		color: var(--text-dim);
	}

	.decisao-grid .decisao-label {
		font-weight: 800;
		color: var(--text);
		margin-bottom: 6px;
	}

	.exp-grid {
		grid-template-columns: repeat(3, 1fr);
	}

	.exp-card p {
		margin: 0;
	}

	.exp-empresa {
		font-weight: 800;
		color: var(--text);
		font-size: 1.05rem;
	}

	.exp-cargo {
		color: var(--cyan);
		font-weight: 700;
		margin-top: 4px !important;
	}

	.exp-periodo,
	.exp-antes {
		color: var(--text-dim);
		font-size: 0.85rem;
		margin-top: 6px !important;
	}

	.ferramentas-grid {
		grid-template-columns: repeat(3, 1fr);
	}

	.ferramenta {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		border: 1px solid var(--panel-border);
		border-radius: 14px;
		overflow: hidden;
		background: var(--bg);
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	.ferramenta:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(37, 99, 235, 0.12);
		text-decoration: none;
	}

	.ferramenta img {
		width: 100%;
		height: auto;
		display: block;
	}

	.ferramenta-body {
		padding: 14px 16px 18px;
		font-family: var(--body);
		font-size: 0.9rem;
		color: var(--text-dim);
	}

	.ferramenta-body p {
		margin: 0;
	}

	.ferramenta-body .ferramenta-nome {
		font-weight: 800;
		color: var(--text);
		margin-bottom: 4px;
	}

	.podcasts-grid {
		max-width: 1080px;
		margin: 0 auto;
		padding: 0 24px;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 16px;
	}

	.podcasts-grid iframe {
		border-radius: 12px;
		border: 0;
	}

	@media (max-width: 900px) {
		.hero-grid {
			grid-template-columns: 1fr;
		}

		.hero-card {
			max-width: 360px;
			margin: 0 auto;
		}

		.pilares-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.decisao-grid,
		.exp-grid,
		.ferramentas-grid,
		.podcasts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
