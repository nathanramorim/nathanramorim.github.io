---
import RetroLayout from '../../layouts/RetroLayout.astro';
import FeaturedPosts from '../../presentation/components/FeaturedPosts.astro';
import { GetAllPosts } from '../../domain/usecases/GetAllPosts';

const posts = await GetAllPosts();
---

<RetroLayout title="Blog — Nathan Amorim" chromeTitle="blog/index">
	<header class="index-hero">
		<p class="eyebrow">cat readme.md</p>
		<h1>Blog<span class="cursor">&nbsp;</span></h1>
		<p>Artigos sobre engenharia de software, arquitetura e o dia a dia de construir sistemas com IA.</p>
	</header>

	<FeaturedPosts posts={posts} />
</RetroLayout>
