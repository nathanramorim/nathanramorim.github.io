---
import RetroLayout from '../layouts/RetroLayout.astro';
import Avatar from '../presentation/components/Avatar.astro';
import ResumeSection from '../presentation/components/ResumeSection.astro';
import SiteFooter from '../presentation/components/SiteFooter.astro';
import { GetExperienceHistory } from '../domain/usecases/GetExperienceHistory';
import { GetProjectsList } from '../domain/usecases/GetProjectsList';
import { ProjectRepository } from '../data/repositories/ProjectRepository';
import { PagesConfigRepository } from '../data/repositories/PagesConfigRepository';

if (!new PagesConfigRepository().isEnabled('cv')) {
	return Astro.redirect('/', 302);
}

const { experiences, education, certifications, languages } = await GetExperienceHistory();
const projects = await new GetProjectsList(new ProjectRepository()).execute();
---

<RetroLayout
	title="Currículo · Nathan Amorim"
	description="Trajetória profissional, formação acadêmica e competências técnicas de Nathan Amorim, resolvedor de problemas com tecnologia."
	chromeTitle="cv.md"
>
	<header class="index-hero hero-with-avatar">
		<Avatar size={96} />
		<div>
			<p class="eyebrow">Currículo</p>
			<h1>Nathan Amorim<span class="cursor">&nbsp;</span></h1>
			<p>Resolvedor de problemas, com tecnologia · Full Stack Sênior · Tech Lead · Arquiteto de Soluções</p>
			<p class="print-only cv-print-contact">
				nathan.ramorim@gmail.com · linkedin.com/in/nathanamorim · github.com/nathanramorim
			</p>
		</div>
	</header>

	<ResumeSection
		experiences={experiences}
		education={education}
		certifications={certifications}
		languages={languages}
		projects={projects}
		downloadMode="print"
	/>

	<SiteFooter />
</RetroLayout>
